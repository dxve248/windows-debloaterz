<Application x:Class="WindowsDebloater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- palette -->
            <SolidColorBrush x:Key="WindowBgBrush"    Color="#17171A"/>
            <SolidColorBrush x:Key="PanelBgBrush"     Color="#1E1E23"/>
            <SolidColorBrush x:Key="CardBgBrush"      Color="#26262D"/>
            <SolidColorBrush x:Key="CardHoverBrush"   Color="#2F2F38"/>
            <SolidColorBrush x:Key="HeaderBgBrush"    Color="#222228"/>
            <SolidColorBrush x:Key="BorderBrush"      Color="#3A3A45"/>
            <SolidColorBrush x:Key="TextBrush"        Color="#ECECF1"/>
            <SolidColorBrush x:Key="DimBrush"         Color="#8E8E9C"/>
            <SolidColorBrush x:Key="FaintBrush"       Color="#5C5C68"/>
            <SolidColorBrush x:Key="AccentBrush"      Color="#4CC2FF"/>
            <SolidColorBrush x:Key="AccentDeepBrush"  Color="#1F6F92"/>
            <SolidColorBrush x:Key="WarnBrush"        Color="#FFC24B"/>
            <SolidColorBrush x:Key="DangerBrush"      Color="#FF6B6B"/>
            <SolidColorBrush x:Key="GoodBrush"        Color="#6BD97E"/>
            <SolidColorBrush x:Key="TrackBgBrush"     Color="#2C2C33"/>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- text -->
            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="Dim" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            </Style>
            <Style x:Key="Faint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            </Style>

            <!-- buttons -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#10131A"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#7FD4FF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- text box -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource TrackBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- scrollbars -->
            <Style x:Key="ScrollThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#4A4A57" CornerRadius="4" Margin="2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="11"/>
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- item checkbox -->
            <Style x:Key="ItemCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border Background="Transparent" Padding="4,3">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                            Background="{StaticResource TrackBgBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1.5"
                                            VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Path x:Name="Tick"
                                              Data="M 3,8.5 L 6.5,12 L 14,3.5"
                                              Stroke="#10131A" StrokeThickness="2.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- category header -->
            <Style x:Key="GroupHeaderToggle" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{StaticResource HeaderBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="9,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Chev" Grid.Column="0" Width="9" Height="9"
                                          Stretch="Uniform" Fill="{StaticResource DimBrush}"
                                          Data="M 0,0 L 9,0 L 4.5,7 Z"
                                          RenderTransformOrigin="0.5,0.5"
                                          VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Content}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Count" Grid.Column="2"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{StaticResource FaintBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Chev" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="-90"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="GroupHeaderText">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            </DataTemplate>

            <DataTemplate x:Key="ItemTemplate">
                <CheckBox Style="{StaticResource ItemCheckBox}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsEnabled}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding RiskBadge}" FontSize="11"
                                       Foreground="{StaticResource WarnBrush}"
                                       Margin="7,1,0,0"
                                       Visibility="{Binding HasRiskBadge, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource FaintBrush}"
                                       Margin="7,1,0,0"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                   Foreground="{StaticResource DimBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="480"/>
                    </StackPanel>
                </CheckBox>
            </DataTemplate>

            <DataTemplate x:Key="GroupTemplate">
                <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ToggleButton Grid.Row="0"
                                  Style="{StaticResource GroupHeaderToggle}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Content="{Binding Name}"
                                  ContentTemplate="{StaticResource GroupHeaderText}"
                                  Tag="{Binding CountText}"
                                  HorizontalContentAlignment="Stretch"/>
                    <ItemsControl Grid.Row="1" Margin="6,4,0,0"
                                  ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource ItemTemplate}"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DataTemplate>

            <!-- progress -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="{StaticResource TrackBgBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>